table Calendar
	lineageTag: b67250ce-a82c-4255-8c7f-6a1cc821b45e

	column Date
		dataType: dateTime
		isKey
		formatString: dd MMM yyyy
		lineageTag: 1b886cb4-9963-4508-a0e2-2c1fbfea813f
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 77ea6cd9-2657-499f-b0b7-ee2545bdead5
		summarizeBy: none
		sourceColumn: [Year]

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 362f7319-07c1-4e8d-aa61-96e644514bf7
		summarizeBy: none
		sourceColumn: [Month Number]

	column Month
		dataType: string
		lineageTag: d05b68b0-8996-4db2-b4e0-f58918f46c42
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

	partition Calendar = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    SELECTCOLUMNS(CALENDAR(MIN(Prices[Date]), MAX(Prices[Date])), "Date", [Date]),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "mmm", "en-US")
				)

