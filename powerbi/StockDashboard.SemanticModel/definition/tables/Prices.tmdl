	measure 'Range Note' =
			IF(
			    HASONEVALUE(Tickers[Ticker]),
			    SELECTEDVALUE(Tickers[Name]) & ": " & COUNTROWS(Prices) & " trading days, "
			        & FORMAT(MIN(Prices[Date]), "dd MMM yyyy") & " to " & FORMAT(MAX(Prices[Date]), "dd MMM yyyy")
			        & ". Period return " & FORMAT([Period Return], "+0.00%;-0.00%;0.00%")
			        & ". 52-week range from " & SELECTEDVALUE(Tickers[RangeSource]) & ".",
			    "Select one ticker."
			)
		displayFolder: Text
		lineageTag: 4f0cca43-f891-4b95-b1f1-c1bc076fe056

	measure 'Indicator Summary' = SELECTEDVALUE(Tickers[Summary])
		displayFolder: Text
