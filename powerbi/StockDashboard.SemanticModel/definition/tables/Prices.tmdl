	measure 'Base 100' =
			VAR Chosen = COUNTROWS(ALLSELECTED(Tickers[Ticker]))
			VAR PerDay =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            SUMMARIZE(Prices, Prices[Date]),
			            "@Tickers", CALCULATE(DISTINCTCOUNT(Prices[Ticker]))
			        ),
			        ALLSELECTED()
			    )
			VAR CommonStart = MINX(FILTER(PerDay, [@Tickers] = Chosen), Prices[Date])
			VAR BaseClose =
			    CALCULATE(
			        SUM(Prices[Close]),
			        REMOVEFILTERS('Calendar'), REMOVEFILTERS('Date Range'),
			        Prices[Date] = CommonStart
			    )
			RETURN
			    IF(
			        HASONEVALUE(Tickers[Ticker]) && NOT ISBLANK(CommonStart) && MAX(Prices[Date]) >= CommonStart,
			        DIVIDE(SUM(Prices[Close]), BaseClose) * 100
			    )
		formatString: 0.0
		displayFolder: Analysis
		lineageTag: ae3c1878-ab18-4f40-99f0-2c7b9ab860ba

	measure 'Monthly Return' =
			IF(
			    HASONEVALUE(Tickers[Ticker]) && NOT ISEMPTY(Prices),
			    PRODUCTX(Prices, 1 + Prices[DAILY_RETURN]) - 1
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Analysis
		lineageTag: 76a521da-140d-4ca4-a8c7-e35a6fa9bf1a

	measure 'Monthly Return Colour' =
			VAR R = [Monthly Return]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(R), BLANK(),
			        R >= 0.10, "#4ADE80",
			        R >= 0.03, "#86EFAC",
			        R >= 0, "#DCFCE7",
			        R > -0.03, "#FEE2E2",
			        R > -0.10, "#FCA5A5",
			        "#F87171"
			    )
		displayFolder: Analysis
		lineageTag: 642aecf7-2438-44ca-9c45-f03997bcf4f9

	measure Days = IF(HASONEVALUE(Tickers[Ticker]), COUNT(Prices[DAILY_RETURN]))
		formatString: #,##0
		displayFolder: Analysis
		lineageTag: dffc6d73-0ae7-448e-8351-accc83cdc4b8

	measure Correlation =
			VAR A = SELECTEDVALUE('Correlation Row'[Row Ticker])
			VAR B = SELECTEDVALUE('Correlation Column'[Column Ticker])
			VAR FirstA = CALCULATE(MIN(Prices[Date]), REMOVEFILTERS(Tickers), Prices[Ticker] = A)
			VAR FirstB = CALCULATE(MIN(Prices[Date]), REMOVEFILTERS(Tickers), Prices[Ticker] = B)
			VAR ReturnsA =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(Prices, Prices[Date] > FirstA && NOT ISBLANK(Prices[DAILY_RETURN])),
			            "@Day", Prices[Date],
			            "@X", Prices[DAILY_RETURN]
			        ),
			        REMOVEFILTERS(Tickers),
			        Prices[Ticker] = A
			    )
			VAR Joined =
			    ADDCOLUMNS(
			        ReturnsA,
			        "@Y",
			            VAR D = [@Day]
			            RETURN
			                CALCULATE(
			                    SUM(Prices[DAILY_RETURN]),
			                    ALL(Prices),
			                    REMOVEFILTERS(Tickers),
			                    Prices[Ticker] = B,
			                    Prices[Date] = D
			                )
			    )
			VAR Pairs = FILTER(Joined, NOT ISBLANK([@Y]) && [@Day] > FirstB)
			VAR MeanX = AVERAGEX(Pairs, [@X])
			VAR MeanY = AVERAGEX(Pairs, [@Y])
			VAR Cov = SUMX(Pairs, ([@X] - MeanX) * ([@Y] - MeanY))
			VAR SpreadX = SUMX(Pairs, ([@X] - MeanX) ^ 2)
			VAR SpreadY = SUMX(Pairs, ([@Y] - MeanY) ^ 2)
			RETURN IF(COUNTROWS(Pairs) >= 2, DIVIDE(Cov, SQRT(SpreadX * SpreadY)))
		formatString: 0.00
		displayFolder: Analysis
		lineageTag: 641f0f0c-6aaf-4533-b1a8-ed6f184f85db

	measure 'Correlation Colour' =
			VAR C = [Correlation]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(C), BLANK(),
			        C >= 0.7, "#FB923C",
			        C >= 0.4, "#FDBA74",
			        C >= 0.15, "#FFEDD5",
			        C > -0.15, "#FFFFFF",
			        "#BFDBFE"
			    )
		displayFolder: Analysis
		lineageTag: a0af6715-ddaa-4b73-841a-33a4e0f96583

