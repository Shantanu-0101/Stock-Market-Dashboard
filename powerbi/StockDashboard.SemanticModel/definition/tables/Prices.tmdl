	measure 'Daily Change Card' = IF(HASONEVALUE(Tickers[Ticker]), IF(ISBLANK([Daily Change]), "—", FORMAT([Daily Change], "+0.00%;-0.00%;0.00%")))
		displayFolder: KPI
		lineageTag: 52dc0512-3836-40cd-8ddb-b869ce44bb39

	measure 'YTD Card' = IF(HASONEVALUE(Tickers[Ticker]), IF(ISBLANK([YTD Return]), "—", FORMAT([YTD Return], "+0.00%;-0.00%;0.00%")))
