	measure RSI =
			IF(
			    HASONEVALUE(Tickers[Ticker]),
			    IF(
			        SELECTEDVALUE('RSI Formula'[Formula], "Spec (rolling mean)") = "Wilder (standard)",
			        SUM(Prices[RSI_14_WILDER]),
			        SUM(Prices[RSI_14])
			    )
			)
		formatString: 0.0
		displayFolder: Chart series
		lineageTag: 410d4501-be2d-4fe7-b9aa-dd531c9d8226

	measure 'RSI Overbought' = IF(NOT ISBLANK([RSI]), 70)
		formatString: 0
		displayFolder: Chart series
		lineageTag: 3edf71f8-62df-4e59-b4cb-050e7fb8c0ae

	measure 'RSI Oversold' = IF(NOT ISBLANK([RSI]), 30)
		formatString: 0
		displayFolder: Chart series
		lineageTag: bbf6b527-8281-43eb-8ba4-3039349b2e52

	measure 'Last Close' =
			VAR LastDay = MAX(Prices[Date])
			RETURN IF(HASONEVALUE(Tickers[Ticker]), CALCULATE(SUM(Prices[Close]), Prices[Date] = LastDay))
		formatString: #,##0.00
		displayFolder: KPI
		lineageTag: 9e25635c-63cf-4907-a1a6-77abb5811585

	measure 'Daily Change' =
			VAR LastDay = MAX(Prices[Date])
			RETURN
			    IF(
			        HASONEVALUE(Tickers[Ticker]) && COUNTROWS(Prices) > 1,
			        CALCULATE(SUM(Prices[DAILY_RETURN]), Prices[Date] = LastDay)
			    )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: KPI
		lineageTag: 57e09ec6-ac16-4d07-9bb1-cade910644b4

	measure 'Period Return' =
			VAR FirstDay = MIN(Prices[Date])
			VAR FirstClose = CALCULATE(SUM(Prices[Close]), Prices[Date] = FirstDay)
			RETURN IF(HASONEVALUE(Tickers[Ticker]) && COUNTROWS(Prices) > 1, DIVIDE([Last Close], FirstClose) - 1)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: KPI
		lineageTag: 8e8f7996-72fd-44c2-9048-ab3fe87a8769

	measure 'YTD Return' =
			VAR LastDay = MAX(Prices[Date])
			VAR Boundary = DATE(YEAR(LastDay), 1, 1)
			VAR PriorDay =
			    CALCULATE(
			        MAX(Prices[Date]),
			        REMOVEFILTERS('Calendar'), REMOVEFILTERS('Date Range'),
			        Prices[Date] < Boundary
			    )
			VAR FirstOfYear =
			    CALCULATE(
			        MIN(Prices[Date]),
			        REMOVEFILTERS('Calendar'), REMOVEFILTERS('Date Range'),
			        Prices[Date] >= Boundary
			    )
			VAR BaseDay = COALESCE(PriorDay, FirstOfYear)
			VAR BaseClose =
			    CALCULATE(
			        SUM(Prices[Close]),
			        REMOVEFILTERS('Calendar'), REMOVEFILTERS('Date Range'),
			        Prices[Date] = BaseDay
			    )
			RETURN IF(HASONEVALUE(Tickers[Ticker]) && NOT ISBLANK(LastDay), DIVIDE([Last Close], BaseClose) - 1)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: KPI
		lineageTag: f99d50f3-b1b3-4610-b4da-57ade12059fd

	measure Volatility =
			VAR FirstDay = MIN(Prices[Date])
			VAR Later = FILTER(Prices, Prices[Date] > FirstDay && NOT ISBLANK(Prices[DAILY_RETURN]))
			RETURN
			    IF(
			        HASONEVALUE(Tickers[Ticker]) && COUNTROWS(Later) >= 2,
			        STDEVX.S(Later, Prices[DAILY_RETURN]) * SQRT(SELECTEDVALUE(Tickers[PeriodsPerYear]))
			    )
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: c086190e-621c-41f6-b4eb-9ea82509f45a

	measure 'Price Card' =
			VAR Amount = [Last Close]
			RETURN
			    IF(
			        HASONEVALUE(Tickers[Ticker]),
			        IF(
			            ISBLANK(Amount),
			            "—",
			            VAR Symbol = SELECTEDVALUE(Tickers[CurrencySymbol])
			            -- the engine trims trailing spaces, so "Rs " arrives as "Rs"
			            RETURN Symbol & IF(LEN(Symbol) > 1, " ", "") & FORMAT(Amount, "#,##0.00")
			        )
			    )
		displayFolder: KPI
		lineageTag: 0934f0d9-0b5a-430d-96f2-c5b6097db3bd

