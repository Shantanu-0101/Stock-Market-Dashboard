	partition Prices = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\prices.csv"), [Delimiter=",", Columns=28, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Date", type date}, {"Ticker", type text}, {"Open", type number}, {"High", type number}, {"Low", type number}, {"Close", type number}, {"Volume", Int64.Type}, {"SMA_20", type number}, {"SMA_50", type number}, {"SMA_200", type number}, {"EMA_12", type number}, {"EMA_26", type number}, {"RSI_14", type number}, {"MACD", type number}, {"MACD_SIGNAL", type number}, {"MACD_HIST", type number}, {"BB_UPPER", type number}, {"BB_MIDDLE", type number}, {"BB_LOWER", type number}, {"BB_PERCENT_B", type number}, {"BB_BANDWIDTH", type number}, {"DAILY_RETURN", type number}, {"CUM_RETURN", type number}, {"DRAWDOWN", type number}, {"VOL_SMA_20", type number}, {"ROLL_VOL_21", type number}, {"RSI_14_WILDER", type number}, {"RETURN_BIN", type number}}, "en-US")
				in
				    Typed

