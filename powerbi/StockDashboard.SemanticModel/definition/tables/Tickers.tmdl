	partition Tickers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\tickers.csv"), [Delimiter=",", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Ticker", type text}, {"Name", type text}, {"Sector", type text}, {"Exchange", type text}, {"CurrencySymbol", type text}, {"PeriodsPerYear", Int64.Type}, {"Week52High", type number}, {"Week52Low", type number}, {"RangeSource", type text}, {"MarketCapText", type text}, {"PERatio", type number}, {"AvgVolumeText", type text}, {"DataTo", type date}, {"Summary", type text}}, "en-US")
				in
				    Typed

